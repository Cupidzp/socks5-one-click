#!/usr/bin/env bash
set -euo pipefail

# Puthsent upstream revision containing Gost v3.3.0 support.
SOURCE_URL='https://gist.githubusercontent.com/Puthsent/36817edc52867fd74559fde96339af99/raw/adb37dc0fddee696944b38f921ae4c0f12736c77/S5'
REPO_SCRIPT_URL='https://raw.githubusercontent.com/Cupidzp/socks5-one-click/main/S5'

tmp_script="$(mktemp)"
trap 'rm -f "$tmp_script"' EXIT

if command -v curl >/dev/null 2>&1; then
    if ! curl --fail --location --silent --show-error --retry 3 --connect-timeout 10 --max-time 120 "$SOURCE_URL" -o "$tmp_script"; then
        echo '错误：无法下载上游部署脚本。' >&2
        exit 1
    fi
elif command -v wget >/dev/null 2>&1; then
    if ! wget --quiet --timeout=120 -O "$tmp_script" "$SOURCE_URL"; then
        echo '错误：无法下载上游部署脚本。' >&2
        exit 1
    fi
else
    echo '错误：需要 curl 或 wget 才能下载部署脚本。' >&2
    exit 1
fi

if [[ ! -s "$tmp_script" ]]; then
    echo '错误：上游脚本下载结果为空。' >&2
    exit 1
fi

if [[ "$(head -n 1 "$tmp_script")" != '#!/usr/bin/env bash' ]]; then
    echo '错误：下载内容不是预期的 Bash 脚本。' >&2
    exit 1
fi

# Port-based checks work when restricted containers hide process ownership in ss.
sed -i '691c\    elif command -v ss >/dev/null 2>&1 && ss -lnt 2>/dev/null | grep -qE "[:.]${port}([[:space:]]|$)"; then' "$tmp_script"
sed -i '693c\    elif command -v netstat >/dev/null 2>&1 && netstat -lnt 2>/dev/null | grep -qE "[:.]${port}([[:space:]]|$)"; then' "$tmp_script"
# BusyBox mktemp requires the XXXXXX template at the end; file contents determine the format.
sed -i '1400c\        gost_archive=$(mktemp "$gost_dir/gost.XXXXXX") || exit 1' "$tmp_script"
sed -i '1524c\        if command -v ss >/dev/null 2>&1 && ss -lnt 2>/dev/null | grep -qE "[:.]${port}([[:space:]]|$)"; then is_running=1; break; fi' "$tmp_script"
sed -i '1525c\        if command -v netstat >/dev/null 2>&1 && netstat -lnt 2>/dev/null | grep -qE "[:.]${port}([[:space:]]|$)"; then is_running=1; break; fi' "$tmp_script"
sed -i '1691c\    local temp_script; temp_script=$(mktemp "$update_dir/update.XXXXXX") || return' "$tmp_script"
sed -i "s|https://gist.githubusercontent.com/Puthsent/36817edc52867fd74559fde96339af99/raw/S5|${REPO_SCRIPT_URL}|g" "$tmp_script"

if ! grep -qF 'ss -lnt 2>/dev/null | grep -qE "[:.]${port}([[:space:]]|$)"' "$tmp_script"; then
    echo '错误：无法安装监听端口状态检测修复。' >&2
    exit 1
fi
if ! grep -qF 'gost_archive=$(mktemp "$gost_dir/gost.XXXXXX")' "$tmp_script"; then
    echo '错误：无法安装 BusyBox mktemp 兼容修复。' >&2
    exit 1
fi
if ! grep -qF 'temp_script=$(mktemp "$update_dir/update.XXXXXX")' "$tmp_script"; then
    echo '错误：无法安装更新临时文件修复。' >&2
    exit 1
fi
if ! grep -qF 'ss -lnt 2>/dev/null | grep -qE "[:.]${port}([[:space:]]|$)"; then is_running=1' "$tmp_script"; then
    echo '错误：无法安装主面板监听状态修复。' >&2
    exit 1
fi
if ! grep -qF "$REPO_SCRIPT_URL" "$tmp_script"; then
    echo '错误：无法配置仓库更新入口。' >&2
    exit 1
fi

if ! bash -n "$tmp_script"; then
    echo '错误：上游脚本语法检查未通过，已停止执行。' >&2
    exit 1
fi

bash "$tmp_script" "$@"
